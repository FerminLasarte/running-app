# Copiá este archivo a .env.local (desarrollo) y cargá los mismos valores en Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API (o el botón «Connect» del proyecto)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# la «publishable key» (sb_publishable_…). Si tu proyecto muestra la «anon key» vieja, usá NEXT_PUBLIC_SUPABASE_ANON_KEY en su lugar.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Mails con acceso a la app, separados por coma. Vacío = cualquiera que tenga cuenta en tu Supabase.
ALLOWED_EMAILS=

# Strava → https://www.strava.com/settings/api (la app la crea el corredor, con su cuenta)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Lectura de capturas con Claude (opcional). Sin esto, la app esconde esas opciones.
ANTHROPIC_API_KEY=
