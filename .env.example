# Copiá este archivo a .env.local (desarrollo) y cargá los mismos valores en Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API (o el botón «Connect» del proyecto)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# la «publishable key» (sb_publishable_…). Si tu proyecto muestra la «anon key» vieja, usá NEXT_PUBLIC_SUPABASE_ANON_KEY en su lugar.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Mails con acceso a la app, separados por coma. Vacío = cualquiera que tenga cuenta en tu Supabase.
ALLOWED_EMAILS=

# Strava → https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Webhook de Strava (avisa cuando alguien revoca el acceso desde Strava, para borrar lo que vino de ahí). Solo hace falta
# al abrir la app al público (README → «Abrir la app al público»); sin estas dos, /api/strava/webhook responde 501.
# Una palabra cualquiera que inventás vos y repetís al suscribir el webhook:
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Supabase → Project Settings → API Keys: la secret key (sb_secret_…) o la service_role vieja. Se salta el RLS: solo
# en el servidor, nunca con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Lectura de capturas con Claude (opcional). Sin esto, la app esconde esas opciones.
ANTHROPIC_API_KEY=
# Tope de lecturas por usuario por mes (cada pedido cuenta una, con todas sus capturas). Vacío = 30.
AI_MONTHLY_LIMIT=
